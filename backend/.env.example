# Default (leave unset): SQLite at backend/dev.db -- no server needed.
# A relative sqlite:///./x.db path would depend on the directory you start from.
# DATABASE_URL=sqlite:////absolute/path/to/dev.db

# Postgres (install psycopg first: pip install "psycopg[binary]")
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/career_assistant

CORS_ORIGINS=http://localhost:5173

# Aivana MMI. mock = canned responses, no key needed; live = real API calls.
AIVANA_MODE=mock
# Create keys in AI Studio. Keys made on the dev studio (amplifyapp.com) only work
# against the dev API; production keys use https://developers.aivana.ai
AIVANA_API_KEY=
AIVANA_BASE_URL=https://dev-developers.aivana.ai

# Job listings. mock = canned jobs, no key needed (default);
# jsearch = real listings from JSearch (OpenWeb Ninja). Free tier: 200 requests/month,
# so results are cached on disk for 24 h.
JOB_API_MODE=mock
# Needed only for JOB_API_MODE=jsearch:
JSEARCH_API_KEY=
